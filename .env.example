#==============================================================================
# PS-03: Adaptive Exam Prep Agent - Environment Template
# Copy this file to ".env" for local runs. Never commit ".env" with real keys.
#==============================================================================

# --- Application ---
APP_NAME="Adaptive Exam Prep Agent (PS-03)"
ENVIRONMENT=development
DEBUG=true

# --- Database (SQLite + SQLAlchemy) ---
DATABASE_URL=sqlite:///./backend/adaptive_tutor.db

# --- Security & Authentication (PyJWT + bcrypt) ---
JWT_SECRET_KEY=change-this-to-a-long-random-secret-key-before-demo
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# --- LLM Providers (auto | gemini | openai | none) ---
# Leave API keys blank to run 100% offline with deterministic/PDF-excerpt fallbacks.
LLM_PROVIDER=auto
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
LLM_TIMEOUT_SECONDS=20

# --- Modular Retrieval (auto | gemini | openai | local) ---
# "auto" uses API embeddings + per-syllabus FAISS when a key is configured,
# otherwise falls back to honest local TF-IDF / conditional SVD lexical search.
EMBEDDING_PROVIDER=auto

# --- Project Paths (relative to repository root) ---
DATASET_DIR=data/gate_cse
UPLOAD_DIR=backend/uploads
FAISS_INDEX_DIR=backend/faiss_indices

# --- CORS & Frontend Client ---
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173
VITE_API_BASE_URL=http://localhost:8000